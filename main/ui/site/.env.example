NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/nullcs
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Website analysis gateway: all server-only. Demo bytes bypass this server.
# Local defaults only; replace both URLs with the deployed HTTPS worker origin.
NULLCS_API_BASE_URL=http://127.0.0.1:8001
NULLCS_WORKER_PUBLIC_URL=http://127.0.0.1:8001
# Generate independent random secrets (at least 32 characters). Never NEXT_PUBLIC_.
# NULLCS_API_KEY must match the Python worker.
NULLCS_API_KEY=
NULLCS_SESSION_SECRET=

# Optional server-only override. Unset uses src/lib/published-desktop-release.json.
# An empty value disables downloads. Only use a published, verified release asset.
# https://github.com/gjones01/NullCS/releases/download/<tag>/<installer>.exe
NULLCS_DESKTOP_DOWNLOAD_URL=
